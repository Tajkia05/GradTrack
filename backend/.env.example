# Copy this file to ".env" (same folder) and fill in the values.
# .env is in .gitignore — NEVER commit it, it contains the database password.

# Neon: Dashboard → your project → "Connect" → copy the connection string and paste it here as-is.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

FRONTEND_ORIGIN=http://localhost:5173

# Secret for signing login tokens. Each person can use their own random value.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=paste-a-long-random-value-here
JWT_EXPIRE_MINUTES=60
